// Windows resource file for Quick Unzip — shared by both qunzip.exe (CLI)
// and QuickUnzip.exe (GUI). The OriginalFilename is intentionally generic
// since the same .res is linked into both binaries.

1 ICON "icon.ico"

// Embed the application manifest (RT_MANIFEST, ID 1) directly in the binary so
// its settings — DPI awareness, common-controls v6, and activeCodePage=UTF-8 —
// travel with the exe. An embedded manifest takes precedence over any external
// <exe>.manifest sidecar, so a stale sidecar left at the install location can't
// override it. activeCodePage=UTF-8 is what makes non-ASCII archive paths work
// (GetACP()=65001 → narrow file calls match Kotlin/Native's UTF-8 strings).
1 24 "qunzip.exe.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Quick Unzip"
            VALUE "FileDescription", "Quick Unzip - Archive Extraction Utility"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "quickunzip"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "QuickUnzip.exe"
            VALUE "ProductName", "Quick Unzip"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
